{
  "name": "nerimity-desktop",
  "version": "1.0.0",
  "desktopName": "Nerimity",
  "description": "Nerimity as a desktop AppImage with system tray support",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux appimage",
    "build:flatpak": "electron-builder --linux flatpak",
    "build:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@vencord/venmic": "7.2.5"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.nerimity.desktop",
    "productName": "Nerimity",
    "artifactName": "NerimityV2.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "tts.js",
      "injected/**/*",
      "build/icons/**/*",
      "node_modules/@vencord/venmic/lib/**/*",
      "node_modules/@vencord/venmic/prebuilds/**/*",
      "node_modules/@vencord/venmic/package.json"
    ],
    "asarUnpack": [
      "node_modules/@vencord/venmic/prebuilds/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "syncDesktopName": true,
      "category": "Network;InstantMessaging;",
      "synopsis": "Nerimity chat desktop client",
      "desktop": {
        "entry": {
          "StartupNotify": "true"
        }
      }
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "26.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "26.08",
      "useWaylandFlags": false,
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.portal.ScreenCast"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/256x256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
